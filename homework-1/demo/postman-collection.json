{
  "info": {
    "name": "Banking Transactions API (homework 1)",
    "_postman_id": "a1b2c3d4-0001-4000-8000-bank1ngap1demo",
    "description": "In-memory banking transactions API built for homework 1 of the GenAI and Agentic AI\nfor Software Engineering course.\n\nStart the API first:  ./demo/run.sh   (or ./demo/run.sh --port 3456)\nThen set the {{baseUrl}} variable of the \"Banking API — local\" environment to match.\n\nFolders map 1:1 to the assignment tasks. Requests are named with the status code they\nexpect, and each one carries a test asserting it, so \"Run collection\" verifies the\nwhole API in one click.\n\nFull reference: docs/api-reference.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3456",
      "type": "string"
    },
    {
      "key": "txnId",
      "value": "",
      "type": "string"
    }
  ],
