{
  "name": "banking-transactions-api",
  "version": "1.0.0",
  "description": "Minimal in-memory REST API for banking transactions (AI-assisted development course, homework 1)",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "SEED_FILE=demo/sample-data.json node src/index.js",
    "test": "LOG_LEVEL=silent node --test \"tests/**/*.test.js\"",
    "test:coverage": "LOG_LEVEL=silent node --test --experimental-test-coverage \"tests/**/*.test.js\""
  },
  "keywords": [
    "banking",
    "transactions",
    "rest",
    "express",
    "ai-assisted"
  ],
  "author": "Simone Benevelli",
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0"
  }
}
